# $GANG Site Configuration
# Copy this file to .env and fill in your values.
# Anything left blank renders as "Coming soon" instead of a dead link.

# Solana token contract address (shown in the HUD, start screen, and BUY panel)
VITE_TOKEN_CONTRACT_ADDRESS=

# Dexscreener pair URL
VITE_DEXSCREENER_URL=

# Buy link (Raydium / Jupiter / pump.fun)
VITE_BUY_URL=

# Discord invite
VITE_DISCORD_URL=
